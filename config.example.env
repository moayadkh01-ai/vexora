# ── NoirCue server configuration ─────────────────────────────
# Copy this file to `.env` and fill in real values.

# Server
PORT=3000
HOST=0.0.0.0
DB_PATH=data/noircue.db

# Sessions
SESSION_DAYS=30
COOKIE_SECURE=0            # set to 1 when serving over HTTPS

# Economy (NoirCue Coins)
WELCOME_VC=1000            # welcome bonus on registration
DAILY_VC=500               # base daily bonus (multiplied by VIP)
DAILY_COOLDOWN_H=12
C4_ENTRY=100               # match entry fee
C4_POT=250                 # winner pot (human vs human)
C4_AI_WIN=150              # winner pot (vs AI)
ELO_K=32

# Admin bootstrap (CHANGE IMMEDIATELY in production)
ADMIN_EMAIL=admin@noircue.gg
ADMIN_USER=NoirCue_Admin
ADMIN_PASS=admin123

# ── Payments ────────────────────────────────────────────────
# Until these are set, cash checkout uses the clearly-labelled
# dev/manual provider (admin approval or PAYMENTS_SIMULATE).
# With keys set, real Stripe Checkout + webhooks activate.
#   1) Create products/prices in your Stripe dashboard
#   2) Add a webhook endpoint:  https://YOUR_DOMAIN/api/pay/webhook/stripe
#      event: checkout.session.completed
#   3) Fill the keys below and restart.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENTS_SIMULATE=1        # set 0 on production

# Realtime
RT_POLL_TIMEOUT_S=25
PRESENCE_WINDOW_S=45

# Rate limits (per IP per minute)
RL_AUTH=15
RL_GLOBAL=400

IS_PROD=0
